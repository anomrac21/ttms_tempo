# _headers file
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cache-Control: public, max-age=0, must-revalidate

# Allow all origins to access all index.json files
/**/index.json
  Access-Control-Allow-Origin: *.ttmenus.com
  Access-Control-Allow-Methods: GET
  Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept

# Allow all origins to access the menu items API endpoint
/api/menu-items.json
  Access-Control-Allow-Origin: *.ttmenus.com
  Access-Control-Allow-Methods: GET
  Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept

# Fingerprinted with ?v= from the theme (head/asset-url). Do not serve these
# paths without a version query: iOS will keep them for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/branding/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/main/*
  Cache-Control: public, max-age=604800
